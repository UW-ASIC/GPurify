* 8-wire parallel bus, 1cm long, 50um wide, 35um thick copper, 100um pitch.
* Each wire: 1 segment, 4x4 filaments = 16 filaments. Total 128 filaments, 8 ports.
.units um
.default sigma=5.8e7 nhinc=4 nwinc=4
N1a  x=0     y=0    z=0
N1b  x=10000 y=0    z=0
E1   N1a N1b w=50 h=35
N2a  x=0     y=100  z=0
N2b  x=10000 y=100  z=0
E2   N2a N2b w=50 h=35
N3a  x=0     y=200  z=0
N3b  x=10000 y=200  z=0
E3   N3a N3b w=50 h=35
N4a  x=0     y=300  z=0
N4b  x=10000 y=300  z=0
E4   N4a N4b w=50 h=35
N5a  x=0     y=400  z=0
N5b  x=10000 y=400  z=0
E5   N5a N5b w=50 h=35
N6a  x=0     y=500  z=0
N6b  x=10000 y=500  z=0
E6   N6a N6b w=50 h=35
N7a  x=0     y=600  z=0
N7b  x=10000 y=600  z=0
E7   N7a N7b w=50 h=35
N8a  x=0     y=700  z=0
N8b  x=10000 y=700  z=0
E8   N8a N8b w=50 h=35
.external N1a N1b bus1
.external N2a N2b bus2
.external N3a N3b bus3
.external N4a N4b bus4
.external N5a N5b bus5
.external N6a N6b bus6
.external N7a N7b bus7
.external N8a N8b bus8
.freq fmin=1e6 fmax=1e9 ndec=3
.end
