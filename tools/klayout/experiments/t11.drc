# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
# corner and prl
use({[1,0] => [[0,0,100,100],[130,130,230,230],[0,150,100,250],[300,0,400,100],[100,300,200,400]]})
a=input(1,0)
show("P1 iso(60, transparent, projection_limits(0,1))", a.isolated(60, transparent, projection_limits(0, 1)))
show("P2 iso(60, transparent, projecting < 1)", a.isolated(60, transparent, projecting < 1))
show("P3 iso(60, transparent, projection_limits(100,nil))", a.isolated(60, transparent, projection_limits(100, nil)))
show("P4 iso(60, transparent, projecting >= 100)", a.isolated(60, transparent, projecting >= 100))
show("P5 iso(60, transparent) all", a.isolated(60, transparent))
# magnification
use({[1,0] => [[0,0,101,1000]]})
global_transform(magnification(2))
a=input(1,0)
show("M1 magnified extents", a.extents)
show("M2 sized(-101).sized(101) [orig width>101?]", a.sized(-101).sized(101))
global_transform
