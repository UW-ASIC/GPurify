# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
use({[1,0] => [[0,0,500,1000]]})
a=input(1,0)
show("A all, size 1.0 origin 0 count 1", a.with_density(0.0 .. 1.01, tile_size(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("B all, size 1.0 step 1.0 origin 0 count 1", a.with_density(0.0 .. 1.01, tile_size(1.0), tile_step(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("C nil..0.5 step", a.with_density(nil .. 0.5, tile_size(1.0), tile_step(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("D 0.5..nil step", a.with_density(0.5 .. nil, tile_size(1.0), tile_step(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("E 0.5..1.0 step", a.with_density(0.5 .. 1.0, tile_size(1.0), tile_step(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("F 0.4999..0.5 step", a.with_density(0.4999 .. 0.5, tile_size(1.0), tile_step(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("G pad 2um", a.with_density(0.0 .. 1.01, tile_size(2.0), tile_step(2.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("H pad 2um ignore", a.with_density(0.0 .. 1.01, tile_size(2.0), tile_step(2.0), tile_origin(0.0,0.0), tile_count(1,1), padding_ignore))
