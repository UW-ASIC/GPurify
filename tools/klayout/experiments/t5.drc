# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
# T18 text on edge / corner
use({[1,0] => [[0,0,100,100],[200,0,300,100]], [5,0] => ["100,50,A", "200,0,B"]})
a=input(1,0); t=labels(5,0)
show("T18 text on edge A", a.interacting(t.texts("A")))
show("T18 text on corner B", a.interacting(t.texts("B")))

# T19 nets: m1 shapes A,B joined by via to m2; C separate. space same/diff net
# m1 (1,0): A=[0,0,100,100], B=[150,0,250,100], C=[300,0,400,100]; via (2,0) on A and B; m2 (3,0) bridging
use({[1,0] => [[0,0,100,100],[150,0,250,100],[300,0,400,100]], [2,0] => [[20,20,80,80],[170,20,230,80]], [3,0] => [[0,0,250,100]]})
m1=input(1,0); v=input(2,0); m2=input(3,0)
connect(m1, v); connect(v, m2)
n = m1.nets
show("T19 nets", n)
show("T19 iso(60) props_eq", n.isolated(60, props_eq))
show("T19 iso(60) props_ne", n.isolated(60, props_ne))
show("T19 space(60) props_ne", n.space(60, props_ne))
clear_connections

# T20 connectivity by corner touch: via kisses m1 corner
use({[1,0] => [[0,0,100,100],[300,0,400,100]], [2,0] => [[100,100,150,150]], [3,0] => [[100,100,350,150],[310,10,320,20]]})
m1=input(1,0); v=input(2,0); m2=input(3,0)
connect(m1, v); connect(v, m2)
n = m1.nets
show("T20 kiss-connected nets", n)
show("T20 iso(500) props_eq", n.isolated(500, props_eq))
clear_connections

# T21 density: 2 windows; padding
use({[1,0] => [[0,0,500,1000]], [9,0] => [[0,0,1000,1000]]})
a=input(1,0); bnd=input(9,0)
show("T21 with_density(0..0.6) tile 1000", a.with_density(0.0 .. 0.6, tile_size(1000), tile_origin(0,0), tile_count(1,1)))
show("T21 with_density(nil..0.5) 500/250 boundary", a.with_density(nil .. 0.5, tile_size(0.5), tile_step(0.25), tile_boundary(bnd)))
show("T21 with_density(nil..0.5000001) 500/250 origin", a.with_density(nil .. 0.5000001, tile_size(0.5), tile_step(0.25), tile_origin(0.0,0.0), tile_count(3,3)))
