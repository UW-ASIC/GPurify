# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
show("T1 width(101)", a.width(101))
show("T1 drc(width<100)", a.drc(width < 100))
show("T1 drc(width<=100)", a.drc(width <= 100))

# T2 kissing corners
use({[1,0] => [[0,0,100,100],[100,100,200,200]]})
a = input(1,0)
show("T2 merged", a.merged)
show("T2 width(50)", a.width(50))
show("T2 width(50, without_touching_corners)", a.width(50, without_touching_corners))
show("T2 space(50)", a.space(50))
show("T2 space(50,wtc)", a.space(50, without_touching_corners))
show("T2 iso(50)", a.isolated(50))
show("T2 notch(50)", a.notch(50))
show("T2 area", a.with_area(nil, 15000))
a.data.min_coherence = true
show("T2 mincoh merged", a.merged)
show("T2 mincoh with_area<15000", a.with_area(nil, 15000))

# T3 space equality, shielding
use({[1,0] => [[0,0,100,1000],[200,0,300,1000],[140,0,160,1000]]})
a = input(1,0)
show("T3 iso(40)", a.isolated(40))
show("T3 iso(41)", a.isolated(41))
show("T3 iso(150) shielded", a.isolated(150))
show("T3 iso(150) transparent", a.isolated(150, transparent))

# T4 euclidean neck
use({[1,0] => [[0,0,100,100],[70,70,170,170]]})
a = input(1,0)
show("T4 width(42)", a.width(42))
show("T4 width(43)", a.width(43))
show("T4 width(43,projection)", a.width(43, projection))

# T5 kissing chain notch
use({[1,0] => [[0,0,10,10],[10,10,20,20],[20,0,30,10]]})
a = input(1,0)
show("T5 merged", a.merged)
show("T5 notch(11,wtc)", a.notch(11, without_touching_corners))
show("T5 space(11,wtc)", a.space(11, without_touching_corners))
show("T5 iso(11,wtc)", a.isolated(11, without_touching_corners))
