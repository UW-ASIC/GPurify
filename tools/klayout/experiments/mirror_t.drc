# --- generated header (what translate.rs would emit) ---
require "json"
SCALE = 2                                   # run at x2 so every half-limit is an integer dbu
src = source($gds).global_transform(magnify(SCALE))
$out = File.open($jsonl, "w")
def emit(rule, kind, layer)                 # one JSON line per result object, ints in magnified dbu
  layer.data.each do |o|
    rec = { rule: rule, kind: kind }
    case o
    when RBA::EdgePair then rec[:ep] = [[o.first.x1, o.first.y1, o.first.x2, o.first.y2], [o.second.x1, o.second.y1, o.second.x2, o.second.y2]]; rec[:d] = o.distance
    when RBA::Edge     then rec[:e] = [o.x1, o.y1, o.x2, o.y2]
    when RBA::Polygon  then rec[:hull] = o.each_point_hull.map { |p| [p.x, p.y] }; rec[:holes] = o.holes
    end
    $out.puts JSON.generate(rec)
  end
end
def mincoh(l) ; l.data.min_coherence = true ; l ; end
deep_off = flat
m1 = mincoh(src.input(1, 0)); m2 = src.input(2, 0); bnd = src.input(9, 0)
# --- rules (lengths already x SCALE) ---
emit("m1.w",   "ep",  m1.width(102 * SCALE, euclidian, shielded, without_touching_corners))
emit("m1.s",   "ep",  src.input(1,0).isolated(70 * SCALE, euclidian, transparent))
emit("m1.mw",  "fig", m1.sized(-100 * SCALE / 2).sized(100 * SCALE / 2))
emit("m12.sd", "ep",  m2.separation(m1, 10 * SCALE, euclidian, transparent))
emit("m12.sd", "fig", m2 & m1)
emit("m1.a",   "fig", m1.with_area(nil, 15000 * SCALE * SCALE))
$out.close
