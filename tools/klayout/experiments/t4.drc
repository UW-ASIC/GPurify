# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
# T14 texts: text inside, on edge, outside; glob
use({[1,0] => [[0,0,100,100],[200,0,300,100],[400,0,500,100]], [5,0] => ["50,50,VDD", "300,50,VSS", "600,50,VDD"]})
a=input(1,0); t=labels(5,0)
show("T14 interacting VDD", a.interacting(t.texts("VDD")))
show("T14 interacting V*", a.interacting(t.texts("V*")))
show("T14 interacting V?D", a.interacting(t.texts(pattern("V?D"))))
show("T14 not_interacting V*", a.not_interacting(t.texts("V*")))
show("T14 text exact", a.interacting(t.texts(text("V*"))))

# T15 area units
use({[1,0] => [[0,0,300,400]]})
a=input(1,0)
show("T15 with_area(nil,100000) int", a.with_area(nil, 100000))
show("T15 with_area(nil,0.2) float", a.with_area(nil, 0.2))
show("T15 with_area(120000) exact", a.with_area(120000))

# T16 ongrid raw vs merged; with_angle raw
use({[1,0] => [[0,0,103,100],[50,0,200,100]]})
a=input(1,0)
show("T16 ongrid(5) merged", a.ongrid(5))
show("T16 raw.ongrid(5)", a.raw.ongrid(5))
a2=input(1,0)
use({[1,0] => [[[0,0],[0,100],[50,150],[100,100],[100,0]]]})
a=input(1,0)
show("T16 edges.without_angle(ortho)", a.edges.without_angle(ortho))
show("T16 edges.with_angle(45)", a.edges.with_angle(45))
show("T16 edges.with_angle(-45)", a.edges.with_angle(-45))

# T17 universal angle filter for asymmetric
use({[1,0] => [[100,100,200,200]], [2,0] => [[[40,40],[40,260],[150,260],[150,220],[260,220],[260,40]]]})
i=input(1,0); o=input(2,0)
show("T17 univ vert-fail", i.drc((enclosed(o, projection) < 50).first_edges.angle == 90))
show("T17 univ horiz-fail", i.drc((enclosed(o, projection) < 50).first_edges.angle == 0))
show("T17 asym", i.drc(if_all((enclosed(o, projection) < 50).first_edges.angle == 90, (enclosed(o, projection) < 50).first_edges.angle == 0)))
use({[1,0] => [[100,100,200,200]], [2,0] => [[90,90,260,260]]})
i=input(1,0); o=input(2,0)
show("T17 asym L", i.drc(if_all((enclosed(o, projection) < 50).first_edges.angle == 90, (enclosed(o, projection) < 50).first_edges.angle == 0)))
