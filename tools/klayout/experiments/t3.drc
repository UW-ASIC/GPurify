# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
# T9 asymmetric enclosure via rectangle filter
# inner 100x100 at (100,100); host margins: l=10 r=10 b=60 t=60 -> pass (b/t axis ok)
use({[1,0] => [[100,100,200,200]], [2,0] => [[90,40,210,260]]})
o=input(2,0); i=input(1,0)
show("T9a pass-axis", o.enclosing(i, 50, projection, whole_edges, one_side_allowed, two_opposite_sides_allowed))
# l=10 b=10 r=60 t=60 -> fail (L config)
use({[1,0] => [[100,100,200,200]], [2,0] => [[90,90,260,260]]})
o=input(2,0); i=input(1,0)
show("T9b L-config", o.enclosing(i, 50, projection, whole_edges, one_side_allowed, two_opposite_sides_allowed))
# one side only: l=10 others 60 -> pass
use({[1,0] => [[100,100,200,200]], [2,0] => [[90,40,260,260]]})
o=input(2,0); i=input(1,0)
show("T9c one side", o.enclosing(i, 50, projection, whole_edges, one_side_allowed, two_opposite_sides_allowed))
# notched host: top margin 60 except a bite over x 150..200 at 20 -> GPurify: top=20 fails; l=r=10 fail -> fail.
use({[1,0] => [[100,100,200,200]], [2,0] => [[[90,40],[90,260],[150,260],[150,220],[210,220],[210,40]]]})
o=input(2,0); i=input(1,0)
show("T9d notched no-whole", o.enclosing(i, 50, projection, one_side_allowed, two_opposite_sides_allowed))
show("T9d notched whole", o.enclosing(i, 50, projection, whole_edges, one_side_allowed, two_opposite_sides_allowed))
# notched host where l/r fine (60) and top bite 20, bottom 60 -> GPurify: max(min(60,60), min(60,20)) = 60 pass
use({[1,0] => [[100,100,200,200]], [2,0] => [[[40,40],[40,260],[150,260],[150,220],[260,220],[260,40]]]})
o=input(2,0); i=input(1,0)
show("T9e notched one side whole", o.enclosing(i, 50, projection, whole_edges, one_side_allowed, two_opposite_sides_allowed))
show("T9e notched one side nowhole", o.enclosing(i, 50, projection, one_side_allowed, two_opposite_sides_allowed))

# T10 sized
use({[1,0] => [[[0,0],[0,300],[100,300],[100,100],[300,100],[300,0]]]})
a=input(1,0)
show("T10 sized(10)", a.sized(10))
show("T10 sized(-10)", a.sized(-10))
show("T10 sized(-50)", a.sized(-50))
show("T10 sized(-49)", a.sized(-49))
show("T10 sized(-60).sized(60)", a.sized(-60).sized(60))

# T11 interacting / inside / outside
use({[1,0] => [[0,0,100,100],[300,0,400,100],[600,0,700,100],[900,0,1000,100]], [2,0] => [[100,100,200,200],[250,0,450,100],[700,0,800,100]]})
a=input(1,0); b=input(2,0)
show("T11 interacting", a.interacting(b))
show("T11 inside", a.inside(b))
show("T11 outside", a.outside(b))
show("T11 not_interacting", a.not_interacting(b))

# T12 holes with island
use({[1,0] => [[[0,0],[0,400],[400,400],[400,0],[0,0],[100,100],[300,100],[300,300],[100,300],[100,100]], [150,150,250,250]]})
a=input(1,0)
show("T12 merged", a.merged)
show("T12 holes", a.holes)
show("T12 with_area(<=170000)", a.with_area(nil, 170000))
show("T12 extents", a.extents)

# T13 edges
use({[1,0] => [[0,0,100,100]], [2,0] => [[100,0,200,50]], [3,0] => [[50,-50,150,20]]})
a=input(1,0); b=input(2,0); c=input(3,0)
show("T13 a.edges", a.edges)
show("T13 a.edges & b.edges", a.edges & b.edges)
show("T13 a.edges - b.edges", a.edges - b.edges)
show("T13 a.edges.inside_part(c)", a.edges.inside_part(c))
show("T13 a.edges.outside_part(c)", a.edges.outside_part(c))
show("T13 a.edges.interacting(c)", a.edges.interacting(c))
show("T13 a.edges.with_length(100)", a.edges.with_length(100))
show("T13 a.edges.with_length(nil,100)", a.edges.with_length(nil,100))
