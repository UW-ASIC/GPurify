# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
# T20b corner-touch connectivity
use({[1,0] => [[0,0,100,100],[300,0,400,100]], [2,0] => [[100,100,150,150],[320,20,380,80]], [3,0] => [[100,100,400,150],[320,20,380,150]]})
m1=input(1,0); v=input(2,0); m2=input(3,0)
connect(m1, v); connect(v, m2)
show("T20b nets", m1.nets)
clear_connections
# abut connectivity
use({[1,0] => [[0,0,100,100],[300,0,400,100]], [2,0] => [[100,50,150,100],[320,20,380,80]], [3,0] => [[100,50,400,150],[320,20,380,150]]})
m1=input(1,0); v=input(2,0); m2=input(3,0)
connect(m1, v); connect(v, m2)
show("T20c abut nets", m1.nets)
clear_connections

# T21b density origin formula and equality
use({[1,0] => [[0,0,500,1000]]})
a=input(1,0)
show("T21b origin(0.125) step .25 size .5 count 3x1", a.with_density(0.0 .. 1.0, tile_size(0.5), tile_step(0.25), tile_origin(0.125,0.125), tile_count(3,1)))
show("T21b eq: tile 1000 density 0.5, range nil..0.5", a.with_density(nil .. 0.5, tile_size(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("T21b eq: range 0.5..nil", a.with_density(0.5 .. nil, tile_size(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("T21b eq: without nil..0.5", a.without_density(nil .. 0.5, tile_size(1.0), tile_origin(0.0,0.0), tile_count(1,1)))
show("T21b pad: tile 2000 at 0", a.with_density(0.0 .. 0.2, tile_size(2.0), tile_origin(0.0,0.0), tile_count(1,1)))

# T22 report output
report("mirror", "out.lyrdb")
use({[1,0] => [[0,0,100,1000],[150,0,250,1000]]})
a=input(1,0)
a.width(120).output("m1.1", "width(m1) >= 120nm")
a.isolated(60).output("m1.2", "space(m1) >= 60nm")
a.output("figs:m1")
a.edges.output("edges:m1")
