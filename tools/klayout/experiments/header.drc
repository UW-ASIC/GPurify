require "json"
flat
SRC = source($gds).global_transform(magnify(2))
$out = File.open($jsonl, "w")
def pts(it) ; it.map { |p| [p.x, p.y] } ; end
def seg(e) ; [e.x1, e.y1, e.x2, e.y2] ; end
# One JSON line per result object; integers are dbu of the x2 layout.
def emit(rule, layer)
  data = layer.is_a?(DRC::DRCLayer) ? layer.data : layer
  data.each do |o|
    rec = case o
          when RBA::EdgePair then { ep: [seg(o.first), seg(o.second)], d: o.distance }
          when RBA::Edge     then { e: seg(o) }
          when RBA::Polygon  then { hull: pts(o.each_point_hull), holes: (0...o.holes).map { |h| pts(o.each_point_hole(h)) } }
          else { other: o.to_s }
          end
    $out.puts JSON.generate({ rule: rule }.merge(rec))
  end
end
def mc(l) ; l.data.min_coherence = true ; l ; end
m1 = SRC.input(1, 0)
emit("fig:max:m1", m1.data.merged)
emit("fig:min:m1", mc(SRC.input(1, 0)).data.merged)
emit("edges:m1", m1.edges)
emit("w", mc(SRC.input(1,0)).width(220, euclidian, shielded, without_touching_corners))
$out.close
