# helpers: build an in-memory layout and make it the DRC source
def mk(spec)
  ly = RBA::Layout.new
  ly.dbu = 0.001
  top = ly.create_cell("TOP")
  spec.each do |ld, shapes|
    li = ly.layer(ld[0], ld[1])
    shapes.each do |s|
      if s.is_a?(Array) && s[0].is_a?(Array)
        top.shapes(li).insert(RBA::Polygon.new(s.map { |x, y| RBA::Point.new(x, y) }))
      elsif s.is_a?(String)
        x, y, t = s.split(",")
        top.shapes(li).insert(RBA::Text.new(t, RBA::Trans.new(x.to_i, y.to_i)))
      else
        top.shapes(li).insert(RBA::Box.new(*s))
      end
    end
  end
  ly
end
def use(spec)
  $ly = mk(spec)
  source($ly, "TOP")
end
def ep_s(ep)
  r = []
  ep.data.each { |e| r << "#{e.first} | #{e.second} d=#{e.distance}" }
  r.join("; ")
end
def show(name, layer)
  d = layer.data
  n = layer.count
  items = []
  d.each { |o| items << o.to_s } if n < 12
  puts "#{name}: count=#{n} #{items.join(' ; ')}"
end
flat

# T1 width equality
use({[1,0] => [[0,0,100,1000]]})
a = input(1,0)
show("T1 width(100)", a.width(100))
use({[1,0] => [[0,0,10,10],[30,0,40,10],[100,0,110,10],[105,0,115,10]]})
c=input(1,0).raw
g=c.sized(20).raw
show("R1 c.interacting(g,2)", c.interacting(g, 2))
show("R2 c.not_interacting(g,2)", c.not_interacting(g, 2))
# edge pairs: back-to-back and same-direction on edge layers
use({[1,0] => [[0,0,100,100],[0,120,100,220]], [2,0] => [[0,300,100,400]], [3,0] => [[0,420,100,520]]})
e=input(1,0).edges
show("E5 width(25) on edges (bottom of C vs top of A are face-to-face; none b2b)", e.width(25))
f=(input(1,0).edges.with_angle(0)).inside_part(input(1,0).sized(1))
# construct b2b: top edge of A (dir L->R? ) and bottom edge of A shifted
ea = input(2,0).edges.with_angle(0)
eb = input(3,0).edges.with_angle(0)
show("E6 ea", ea)
show("E6 eb", eb)
show("E7 ea.separation(eb,25)", ea.separation(eb, 25))
show("E8 ea.enclosing(eb,25)", ea.enclosing(eb, 25))
show("E9 ea.enclosed(eb,25)", ea.enclosed(eb, 25))
show("E10 ea.overlap(eb,25)", ea.overlap(eb, 25))
